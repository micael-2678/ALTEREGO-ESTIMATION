# Base de données
MONGO_URL=mongodb://localhost:27017
DB_NAME=alterego_db

# Administration (désactivée si une valeur manque)
JWT_SECRET=          # 32+ caractères aléatoires : openssl rand -hex 32
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Brevo (SMS de vérification + contacts)
BREVO_API_KEY=
BREVO_SENDER_NAME=AlterEgo
MAX_OTP_ATTEMPTS=5
# Numéros dispensés de vérification SMS (séparés par des virgules), ex. le vôtre :
# BYPASS_PHONE_NUMBER=06 12 34 56 78

# Fond de carte (OpenStreetMap sans clé par défaut ; ex. CARTO avec clé, MapTiler, IGN)
# NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Intégration au site
NEXT_PUBLIC_MAIN_SITE_URL=https://alteregopatrimoine.com
NEXT_PUBLIC_CONTACT_URL=https://alteregopatrimoine.com
# CORS_ORIGINS=https://alteregopatrimoine.com,https://www.alteregopatrimoine.com
# FRAME_ANCESTORS='self' https://alteregopatrimoine.com https://*.alteregopatrimoine.com

# Modèle
# CALIBRATION_OFFSET=-0.08   # ajustement de prudence global (à recalibrer après réimport DVF)
# DVF_YEARS=2021,2022,2023,2024,2025

# Loyers (voir docs/LOYERS.md)
# LOYERS_DATASET=              # identifiant data.gouv.fr d'un millésime précis de la Carte des loyers (sinon le dernier)
# PARIS_LOYERS_YEAR=           # année de l'arrêté parisien à importer (sinon la plus récente)
# RENT_REFERENCE_SURFACES=appartement_1_2:40,appartement_3_plus:72,appartement:49,maison:92
# BREVO_LIST_ID_LOUER=         # liste Brevo des propriétaires bailleurs (attributs : node scripts/create-brevo-attributes.js)
